"use client";

import { useRef, useState } from "react";
import { useRouter } from "next/navigation";
import { motion } from "framer-motion";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import { Badge } from "@/components/ui/badge";
import { Switch } from "@/components/ui/switch";
import { api } from "@/lib/api";

const FAILURE_MODES = [
  { value: "stop", label: "Stop on Failure", description: "Skip every remaining feature file once one fails." },
  { value: "continue", label: "Continue on Failure", description: "Keep running the next feature files regardless." },
  { value: "retry", label: "Retry", description: "Same as Continue for this phase — retried at the next run." },
];

export default function NewExecutionPage() {
  const router = useRouter();
  const fileInputRef = useRef(null);
  const [baseUrl, setBaseUrl] = useState("http://127.0.0.1:9100/login");
  const [transactionNumber, setTransactionNumber] = useState("");
  const [transactionName, setTransactionName] = useState("");
  const [featureFiles, setFeatureFiles] = useState([]);
  const [failureMode, setFailureMode] = useState("stop");
  const [showBrowser, setShowBrowser] = useState(true);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState(null);

  async function handleFilesSelected(fileList) {
    if (!fileList) return;
    const newFiles = await Promise.all(
      Array.from(fileList).map(
        (file) =>
          new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve({ filename: file.name, raw_text: String(reader.result ?? "") });
            reader.onerror = reject;
            reader.readAsText(file);
          })
      )
    );
    setFeatureFiles((prev) => [...prev, ...newFiles]);
  }

  function moveFile(index, direction) {
    setFeatureFiles((prev) => {
      const next = [...prev];
      const target = index + direction;
      if (target < 0 || target >= next.length) return prev;
      [next[index], next[target]] = [next[target], next[index]];
      return next;
    });
  }

  function removeFile(index) {
    setFeatureFiles((prev) => prev.filter((_, i) => i !== index));
  }

  async function handleSubmit(event) {
    event.preventDefault();
    if (featureFiles.length === 0) {
      setError("Upload at least one feature file.");
      return;
    }
    setSubmitting(true);
    setError(null);
    try {
      const execution = await api.startExecution({
        base_url: baseUrl,
        feature_files: featureFiles,
        failure_mode: failureMode,
        headless: !showBrowser,
        transaction_number: transactionNumber || undefined,
        transaction_name: transactionName || undefined,
      });
      router.push(`/execution/${execution.id}`);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to start execution");
      setSubmitting(false);
    }
  }

  return (
    <div className="mx-auto max-w-2xl px-6 py-10">
      <motion.div initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.3 }}>
        <Card>
          <CardHeader>
            <CardTitle>Run a New Execution</CardTitle>
            <CardDescription>
              Executes one or more feature files in upload order against the Locator Repository, with
              Maker-Checker, self-healing, and screenshot capture built in.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <form onSubmit={handleSubmit} className="flex flex-col gap-5">
              <div className="flex flex-col gap-2">
                <Label htmlFor="base_url">Application URL</Label>
                <Input id="base_url" required value={baseUrl} onChange={(e) => setBaseUrl(e.target.value)} />
              </div>

              <div className="rounded-md border border-zinc-200 bg-zinc-50 p-3 text-xs text-zinc-600">
                Login credentials (and Maker/Checker credentials) are managed on the backend (<code>.env</code>) —
                no need to type them here. Feature files can also reference them by placeholder, e.g.{" "}
                <code>the user is logged into NBC using &quot;makerID&quot; and &quot;makerPassword&quot;</code>.
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div className="flex flex-col gap-2">
                  <Label htmlFor="transaction_number">Transaction Number (optional)</Label>
                  <Input
                    id="transaction_number"
                    value={transactionNumber}
                    onChange={(e) => setTransactionNumber(e.target.value)}
                    placeholder="e.g. 001060, 1060"
                  />
                </div>
                <div className="flex flex-col gap-2">
                  <Label htmlFor="transaction_name">Transaction Name (optional)</Label>
                  <Input
                    id="transaction_name"
                    value={transactionName}
                    onChange={(e) => setTransactionName(e.target.value)}
                    placeholder="e.g. Cash Withdrawal"
                  />
                </div>
              </div>
              <p className="-mt-2 text-xs text-zinc-500">
                Leave blank to use the backend default transaction, if one is configured. When filled in, login and
                transaction search are automatically run before each feature file&apos;s own steps — your feature
                files only need the business steps (fill, select, click, ...).
              </p>

              <Separator />

              <div className="flex flex-col gap-2">
                <Label>Feature Files (executed in this order)</Label>
                <input
                  ref={fileInputRef}
                  type="file"
                  multiple
                  accept=".feature"
                  className="hidden"
                  onChange={(e) => handleFilesSelected(e.target.files)}
                />
                <Button type="button" variant="outline" onClick={() => fileInputRef.current?.click()}>
                  Add Feature Files
                </Button>

                {featureFiles.length > 0 && (
                  <ul className="mt-2 flex flex-col gap-2">
                    {featureFiles.map((file, index) => (
                      <li key={`${file.filename}-${index}`} className="flex items-center justify-between rounded-md border p-2 text-sm">
                        <span className="flex items-center gap-2">
                          <Badge variant="outline">{index + 1}</Badge>
                          {file.filename}
                        </span>
                        <span className="flex gap-1">
                          <Button type="button" size="xs" variant="ghost" onClick={() => moveFile(index, -1)}>
                            Up
                          </Button>
                          <Button type="button" size="xs" variant="ghost" onClick={() => moveFile(index, 1)}>
                            Down
                          </Button>
                          <Button type="button" size="xs" variant="ghost" onClick={() => removeFile(index)}>
                            Remove
                          </Button>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <Separator />

              <div className="flex flex-col gap-2">
                <Label>On Failure</Label>
                <div className="grid grid-cols-3 gap-2">
                  {FAILURE_MODES.map((mode) => (
                    <button
                      type="button"
                      key={mode.value}
                      onClick={() => setFailureMode(mode.value)}
                      className={`rounded-md border p-2 text-left text-xs ${
                        failureMode === mode.value ? "border-zinc-950 bg-zinc-50" : "border-zinc-200"
                      }`}
                    >
                      <div className="font-medium">{mode.label}</div>
                      <div className="text-zinc-500">{mode.description}</div>
                    </button>
                  ))}
                </div>
              </div>

              <div className="flex items-center justify-between rounded-md border p-3">
                <div>
                  <Label htmlFor="show_browser">Show browser window</Label>
                  <p className="text-sm text-zinc-500">Watch Microsoft Edge perform the execution live.</p>
                </div>
                <Switch id="show_browser" checked={showBrowser} onCheckedChange={setShowBrowser} />
              </div>

              {error && <p className="text-sm text-red-600">{error}</p>}

              <Button type="submit" disabled={submitting} className="self-start">
                {submitting ? "Starting execution..." : "Run Execution"}
              </Button>
            </form>
          </CardContent>
        </Card>
      </motion.div>
    </div>
  );
}
